<odoo>
    <record id="group_ai_user" model="res.groups">
        <field name="name">Utilisateur Assistant IA</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_ai_validator" model="res.groups">
        <field name="name">Validateur Assistant IA</field>
        <field name="implied_ids" eval="[(4, ref('group_ai_user'))]"/>
    </record>
    <record id="rule_ai_chat_session_owner" model="ir.rule">
        <field name="name">Conversations IA personnelles</field>
        <field name="model_id" ref="model_ai_chat_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_user'))]"/>
    </record>
    <record id="rule_ai_chat_message_owner" model="ir.rule">
        <field name="name">Messages IA personnels</field>
        <field name="model_id" ref="model_ai_chat_message"/>
        <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_user'))]"/>
    </record>
</odoo>
