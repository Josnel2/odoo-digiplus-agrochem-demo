<odoo>
    <record id="action_ai_chat" model="ir.actions.client">
        <field name="name">Assistant IA</field>
        <field name="tag">digiplus_ai_chat</field>
    </record>
    <record id="action_ai_config" model="ir.actions.act_window">
        <field name="name">Configuration DigiPlus IA</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'digiplus_ai_assistant'}</field>
    </record>
    <menuitem id="menu_ai_root" name="DigiPlus IA" sequence="60" groups="base.group_user"/>
    <menuitem id="menu_ai_chat" name="Assistant IA" parent="menu_ai_root" action="action_ai_chat" sequence="5"/>
    <menuitem id="menu_ai_generate" name="Generer un projet" parent="menu_ai_root" action="action_ai_project_generate" sequence="10"/>
    <menuitem id="menu_ai_drafts" name="Brouillons IA" parent="menu_ai_root" action="action_ai_project_drafts" sequence="20"/>
    <menuitem id="menu_ai_config" name="Configuration" parent="menu_ai_root" action="action_ai_config" sequence="30" groups="base.group_system"/>
</odoo>
