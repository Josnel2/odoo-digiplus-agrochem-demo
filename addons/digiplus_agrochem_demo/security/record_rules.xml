<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_whatsapp_message_user" model="ir.rule">
        <field name="name">WhatsApp messages visible to internal users</field>
        <field name="model_id" ref="model_digiplus_whatsapp_message"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_dashboard_metric_user" model="ir.rule">
        <field name="name">Dashboard metrics visible to internal users</field>
        <field name="model_id" ref="model_digiplus_dashboard_metric"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
