<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_digiplus_purchase_order_tree" model="ir.ui.view">
        <field name="name">digiplus.purchase.order.tree</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <list string="Achats et approvisionnement">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="state"/>
                <field name="x_supplier_region"/>
                <field name="x_restock_priority"/>
            </list>
        </field>
    </record>

    <record id="view_digiplus_purchase_order_form" model="ir.ui.view">
        <field name="name">digiplus.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <form string="Commande fournisseur">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="date_order"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="x_supplier_region"/>
                            <field name="x_restock_priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approvisionnement">
                            <group>
                                <field name="x_expected_stock_impact"/>
                                <field name="x_agrochem_purchase_context"/>
                            </group>
                        </page>
                        <page string="Lignes">
                            <field name="order_line">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="price_unit"/>
                                    <field name="date_planned"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
