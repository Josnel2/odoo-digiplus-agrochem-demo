<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_digiplus_account_move_tree" model="ir.ui.view">
        <field name="name">digiplus.account.move.tree</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Facturation clients Odoo">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="x_related_sale_order_id"/>
                <field name="x_related_opportunity_id"/>
                <field name="invoice_date"/>
                <field name="amount_total" sum="Total"/>
                <field name="state"/>
                <field name="x_workflow_origin"/>
                <field name="x_sage_saari_export_status" string="Export externe"/>
                <field name="x_sage_saari_reference" string="Reference externe"/>
            </list>
        </field>
    </record>

    <record id="view_digiplus_account_move_form" model="ir.ui.view">
        <field name="name">digiplus.account.move.form</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <form string="Facture client">
                <header>
                    <button
                        name="action_post_digiplus_workflow"
                        type="object"
                        string="Valider la facture"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_reset_to_draft_digiplus_workflow"
                        type="object"
                        string="Remettre en brouillon"
                        class="btn-secondary"
                        invisible="state != 'posted'"
                    />
                    <button
                        name="action_mark_ready_for_export"
                        type="object"
                        string="Marquer prete export"
                        class="btn-secondary"
                        invisible="state == 'cancel' or x_sage_saari_export_status in ('ready', 'exported')"
                    />
                    <button
                        name="action_open_related_sale_order"
                        type="object"
                        string="Voir le devis"
                        class="btn-secondary"
                        invisible="not x_related_sale_order_id"
                    />
                    <button
                        name="action_open_related_opportunity"
                        type="object"
                        string="Voir l'opportunite"
                        class="btn-secondary"
                        invisible="not x_related_opportunity_id"
                    />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="move_type"/>
                            <field name="partner_id"/>
                            <field name="x_related_sale_order_id" readonly="1"/>
                            <field name="x_related_opportunity_id" readonly="1"/>
                            <field name="journal_id"/>
                            <field name="invoice_date"/>
                            <field name="invoice_date_due"/>
                        </group>
                        <group>
                            <field name="payment_state" readonly="1"/>
                            <field name="invoice_origin"/>
                            <field name="x_workflow_origin" readonly="1"/>
                            <field name="x_sage_saari_export_status" string="Statut export externe"/>
                            <field name="x_sage_saari_reference" string="Reference externe"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Workflow commercial">
                            <group>
                                <group>
                                    <field name="x_related_sale_order_id" readonly="1"/>
                                    <field name="x_related_opportunity_id" readonly="1"/>
                                    <field name="invoice_origin" readonly="1"/>
                                </group>
                                <group>
                                    <field name="x_workflow_origin" readonly="1"/>
                                    <field name="payment_state" readonly="1"/>
                                    <field name="x_integration_comment" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Lignes">
                            <field name="invoice_line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Export comptable externe">
                            <group>
                                <field name="x_sage_saari_export_status" string="Statut export externe"/>
                                <field name="x_sage_saari_reference" string="Reference externe"/>
                                <field name="x_integration_comment" string="Commentaire export / integration"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
