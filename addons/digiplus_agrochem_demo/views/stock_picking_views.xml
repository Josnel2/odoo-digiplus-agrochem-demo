<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_digiplus_stock_picking_tree" model="ir.ui.view">
        <field name="name">digiplus.stock.picking.tree</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Stocks et entrepots">
                <field name="name"/>
                <field name="origin"/>
                <field name="partner_id"/>
                <field name="scheduled_date"/>
                <field name="state"/>
                <field name="x_stock_priority"/>
                <field name="x_client_zone"/>
                <field name="x_rupture_risk"/>
            </list>
        </field>
    </record>

    <record id="view_digiplus_stock_picking_form" model="ir.ui.view">
        <field name="name">digiplus.stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <form string="Mouvement logistique">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="origin"/>
                            <field name="partner_id"/>
                            <field name="picking_type_id"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                            <field name="scheduled_date"/>
                            <field name="x_stock_priority"/>
                            <field name="x_rupture_risk"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contexte operationnel">
                            <group>
                                <field name="x_client_zone"/>
                                <field name="x_demo_comment"/>
                            </group>
                        </page>
                        <page string="Lignes">
                            <field name="move_ids_without_package">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
