<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_demo_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Facture client DigiPlus</h2>
                        <p><strong>Numero:</strong> <span t-esc="o.name or '-'"/></p>
                        <p><strong>Client:</strong> <span t-esc="o.partner_id.display_name"/></p>
                        <p><strong>Date de facture:</strong> <span t-field="o.invoice_date"/></p>
                        <p><strong>Echeance:</strong> <span t-field="o.invoice_date_due"/></p>
                        <p><strong>Journal:</strong> <span t-esc="o.journal_id.display_name"/></p>
                        <t t-if="o.invoice_origin">
                            <p><strong>Origine:</strong> <span t-esc="o.invoice_origin"/></p>
                        </t>
                        <t t-if="o.x_sage_saari_export_status and o.x_sage_saari_export_status != 'not_concerned'">
                            <p><strong>Statut export Sage:</strong> <span t-esc="o.x_sage_saari_export_status"/></p>
                            <t t-if="o.x_sage_saari_reference">
                                <p><strong>Reference Sage:</strong> <span t-esc="o.x_sage_saari_reference"/></p>
                            </t>
                        </t>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Article</th>
                                    <th>Quantite</th>
                                    <th>PU</th>
                                    <th>Sous-total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.invoice_line_ids" t-as="l">
                                    <td><span t-esc="l.name"/></td>
                                    <td><span t-esc="l.quantity"/></td>
                                    <td><span t-field="l.price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td><span t-field="l.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3"><strong>Montant HT</strong></td>
                                    <td><span t-field="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td colspan="3"><strong>Taxes</strong></td>
                                    <td><span t-field="o.amount_tax" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td colspan="3"><strong>Total TTC</strong></td>
                                    <td><span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td colspan="3"><strong>Reste a payer</strong></td>
                                    <td><span t-field="o.amount_residual" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_invoice_demo" model="ir.actions.report">
        <field name="name">Rapport facture DigiPlus</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">digiplus_agrochem_demo.report_invoice_demo_document</field>
        <field name="report_file">digiplus_agrochem_demo.report_invoice_demo_document</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
