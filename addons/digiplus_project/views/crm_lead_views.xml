<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_digiplus_project" model="ir.ui.view">
        <field name="name">crm.lead.form.digiplus.project</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="digiplus_crm.view_digiplus_crm_lead_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_prepare_won_conversion']" position="after">
                <button name="action_create_digiplus_project" type="object" string="Creer le projet" class="btn-secondary" invisible="type != 'opportunity'"/>
                <button name="action_view_digiplus_projects" type="object" string="Voir les projets" class="btn-secondary" invisible="digiplus_project_count == 0"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="digiplus_project_count" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Projets lies">
                    <field name="project_ids" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
