<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_digiplus_crm_contact_import_form" model="ir.ui.view">
        <field name="name">digiplus.crm.contact.import.form</field>
        <field name="model">digiplus.crm.contact.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import de contacts CRM" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="filename"/>
                            <field name="data_file" filename="filename"/>
                            <field name="create_opportunities"/>
                        </group>
                        <group>
                            <field name="line_count" readonly="1"/>
                            <field name="create_count" readonly="1"/>
                            <field name="link_count" readonly="1"/>
                            <field name="validate_count" readonly="1"/>
                            <field name="reject_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <button name="action_parse_file" type="object" string="Analyser le fichier" class="btn-primary"/>
                        <button name="action_apply_import" type="object" string="Appliquer l'import" class="btn-secondary"/>
                    </group>
                    <group>
                        <field name="summary" nolabel="1" readonly="1"/>
                    </group>
                    <group>
                        <field name="line_ids" nolabel="1">
                            <list string="Lignes detectees">
                                <field name="sequence"/>
                                <field name="company_name"/>
                                <field name="contact_name"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="service_requested"/>
                                <field name="action_recommended"/>
                                <field name="existing_partner_id"/>
                                <field name="duplicate_notes"/>
                                <field name="error_message"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
