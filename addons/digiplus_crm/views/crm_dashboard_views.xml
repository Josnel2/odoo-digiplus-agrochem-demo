<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_digiplus_crm_dashboard_form" model="ir.ui.view">
        <field name="name">digiplus.crm.dashboard.form</field>
        <field name="model">digiplus.crm.dashboard.wizard</field>
        <field name="arch" type="xml">
            <form string="Tableau de bord commercial" create="false" edit="false" delete="false">
                <sheet class="dp-crm-dashboard-sheet">
                    <div class="dp-crm-dashboard-toolbar">
                        <div class="dp-crm-dashboard-title-block">
                            <div class="dp-crm-dashboard-title-row">
                                <span class="dp-crm-dashboard-title">Tableau de bord commercial</span>
                                <i class="fa fa-star-o" aria-hidden="true"/>
                            </div>
                            <div class="dp-crm-dashboard-updated-row">
                                <span>Mise a jour :</span>
                                <field name="updated_at_display" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                        <div class="dp-crm-dashboard-toolbar-controls">
                            <div class="dp-crm-dashboard-field-pill">
                                <i class="fa fa-calendar-o" aria-hidden="true"/>
                                <span class="dp-crm-dashboard-pill-label">Periode :</span>
                                <field name="period_filter" nolabel="1"/>
                            </div>
                            <div class="dp-crm-dashboard-field-pill">
                                <i class="fa fa-users" aria-hidden="true" title="Commercial"/>
                                <field name="user_id" nolabel="1" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                            <button name="action_refresh_dashboard" type="object" class="btn btn-primary dp-crm-dashboard-refresh-btn">
                                <i class="fa fa-refresh" aria-hidden="true"/> Actualiser
                            </button>
                            <button name="action_export_dashboard_report" type="object" class="btn btn-secondary dp-crm-dashboard-shortcut-btn">
                                <i class="fa fa-download" aria-hidden="true"/> Exporter rapport
                            </button>
                        </div>
                        <div class="dp-crm-dashboard-toolbar-actions">
                            <button name="action_open_pipeline" type="object" class="btn btn-secondary dp-crm-dashboard-shortcut-btn">
                                <i class="fa fa-filter" aria-hidden="true"/> Pipeline
                            </button>
                            <div class="dp-crm-dashboard-shortcut-pill">
                                <button name="action_open_overdue" type="object" class="btn btn-secondary dp-crm-dashboard-shortcut-btn">
                                    <i class="fa fa-exclamation-triangle" aria-hidden="true"/> Relances en retard
                                </button>
                                <span class="dp-crm-dashboard-shortcut-badge dp-danger">
                                    <field name="overdue_activity_count" readonly="1" nolabel="1"/>
                                </span>
                            </div>
                            <div class="dp-crm-dashboard-shortcut-pill">
                                <button name="action_open_missing_next_action" type="object" class="btn btn-secondary dp-crm-dashboard-shortcut-btn">
                                    <i class="fa fa-clock-o" aria-hidden="true"/> Sans prochaine action
                                </button>
                                <span class="dp-crm-dashboard-shortcut-badge dp-warning">
                                    <field name="missing_next_action_count" readonly="1" nolabel="1"/>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="dp-crm-dashboard-custom-range" invisible="period_filter != 'custom'">
                        <div class="dp-crm-dashboard-field-pill">
                            <span class="dp-crm-dashboard-pill-label">Du</span>
                            <field name="date_from" nolabel="1"/>
                        </div>
                        <div class="dp-crm-dashboard-field-pill">
                            <span class="dp-crm-dashboard-pill-label">Au</span>
                            <field name="date_to" nolabel="1"/>
                        </div>
                    </div>
                    <div class="dp-crm-dashboard-block">
                        <field name="dashboard_html" widget="html" nolabel="1" readonly="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
