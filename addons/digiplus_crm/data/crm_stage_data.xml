<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stage_prospect" model="crm.stage">
        <field name="name">Prospect</field>
        <field name="sequence">10</field>
    </record>
    <record id="stage_qualified" model="crm.stage">
        <field name="name">Qualifié</field>
        <field name="sequence">20</field>
    </record>
    <record id="stage_proposal_sent" model="crm.stage">
        <field name="name">Proposition envoyée</field>
        <field name="sequence">30</field>
    </record>
    <record id="stage_negotiation" model="crm.stage">
        <field name="name">Négociation</field>
        <field name="sequence">40</field>
    </record>
    <record id="stage_won" model="crm.stage">
        <field name="name">Gagné</field>
        <field name="sequence">50</field>
        <field name="fold">True</field>
    </record>
    <record id="stage_lost" model="crm.stage">
        <field name="name">Perdu</field>
        <field name="sequence">60</field>
        <field name="fold">True</field>
    </record>
</odoo>
